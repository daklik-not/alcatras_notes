{
	"nodes":[
		{"id":"543e575200e49749","x":300,"y":-540,"width":948,"height":1339,"type":"text","text":"```\n/* Предварительные условия:\n * 1. svrSock: главный сокет сервера, привязанный к TCP порту 12345\n * 2. toSend: база данных для отслеживания данных, которые нужно отправить клиенту\n * 3. toSend.put(fd, msg) - регистрирует необходимость отправить msg через fd\n * 4. toSend.get(fd) - возвращает строку, которую нужно отправить через fd\n * 5. toSend.destroy(fd) - удаляет всю информацию о fd из toSend\n */\n\ninFds = {svrSock}      /* файловые дескрипторы для отслеживания входящих данных */\noutFds = {}            /* файловые дескрипторы для отслеживания возможности отправки */\nexceptFds = {}         /* файловые дескрипторы для отслеживания исключительных ситуаций (не используется) */\n\nchar msgBuf[MAXMSGSIZE]           /* буфер для приема сообщений */\nchar* thankYouMsg = \"Спасибо!\"    /* ответ для отправки обратно */\n\nwhile (ИСТИНА)\n{\n     Блокировка до тех пор, пока некоторые файловые дескрипторы не будут готовы к использованию */\n    rdyIns, rdyOuts, rdyExcepts = select(inFds, outFds, exceptFds, БЕЗ_ТАЙМАУТА)\n    \n    for (fd in rdyIns) /* Перебор всех соединений, в которых есть данные для нас */\n    {\n        if (fd == svrSock) /* Новое подключение от клиента */\n        {\n            newSock = accept(svrSock)    /* Создание нового сокета для клиента */\n            inFds = inFds ∪ {newSock}    /* Необходимо также отслеживать его */\n        }\n        else\n        { \n            /* Получение сообщения от клиента */\n            n = receive(fd, msgBuf, MAXMSGSIZE)\n            printf(\"Получено: %s.\", msgBuf)\n            \n            toSend.put(fd, thankYouMsg)  /* Необходимо отправить thankYouMsg через fd */\n            outFds = outFds ∪ {fd}       /* Необходимо отслеживать этот fd */\n        }\n    }\n    \n    for (fd in rdyOuts) /* Перебор всех соединений, которые мы можем теперь поблагодарить */\n    {\n        msg = toSend.get(fd)  /* Получение данных, которые нужно отправить через это соединение */\n        n = send(fd, msg, strlen(msg))\n        \n        if (n < strlen(thankYouMsg))\n        {\n            toSend.put(fd, msg + n)  /* Оставшиеся символы для отправки в следующий раз */\n        }\n        else\n        {\n            toSend.destroy(fd)\n            outFds = outFds \\ {fd}  /* Мы уже поблагодарили этого клиента */\n        }\n    }\n}\n```\n"}
	],
