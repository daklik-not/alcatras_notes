		{"id":"d725c25503c86a08","type":"group","x":-80,"y":-240,"width":2345,"height":4220,"label":"Группа без названия"},
		{"id":"a2c3cc4e5c1bfd90","type":"text","text":"### Синхронный Эхо-UDP сервер\n```c\n#include <boost/asio.hpp>\n#include <iostream>\nint main()\n{\n\tstd::uint16_t port = 15001; // порт, который слушаем (uint16_t - 16-битное целое без знака)\n\t\n\tboost::asio::io_context io_context; // создаем обьект io_context для управления асинхронными операциями\n\tboost::asio::ip::udp::endpoint reciever(boost::asio::ip::udp::v4(), port); //создаем endpoint для приема данных, boost::asio::ip::udp::v4() - интерфейс для UDP протокола IPv4;\n\tboost::asio::ip::udp::socket socket(io_context, reciever); // создаем сокет для приема данных, привязываем его к io_context и endpoint;\\\n\n\twhile (true) {\n\t\tchar buffer[65536]; // буфер для хранения полученных данных (макс. размер UDP пакета)\n\t\tboost::asio::ip::udp::endpoint sender; // та же структура для хранение информации об отправителе данных\n\t\tstd::size_t bytes_received = socket.receive_from(boost::asio::buffer(buffer), sender); // слушаем порт, записываем данные в буфер и сохраняем информацию об отправителе в sender;\n\t\tsocket.send_to(boost::asio::buffer(buffer, bytes_received), sender ); // отправляем полученные данные назад оправителю\n\t\tstd::cout << \"Вернуть отправителю\" << std::endl;\n\t}\n\treturn 0;\n}\n```","x":-60,"y":-220,"width":1600,"height":560},
		{"id":"915e856103f088be","type":"text","text":"### Простой TCP сервер\n```c\n#include <boost/asio.hpp>\n#include <iostream>\n#include <optional>\nclass session : public std::enable_shared_from_this<session> { // наследование нужно для вызова shared_from_this() в методе start()\n\tboost::asio::ip::tcp::socket socket; // сокет для обмена данными с клиентом\n\tboost::asio::streambuf streambuf; // буфер для хранения данных, полученных от клиента\n\tpublic:\n\t\tsession(boost::asio::ip::tcp::socket&& socket) : // конструктор класса session\n\t\t\tsocket(std::move(socket)) {}\n\t\tvoid start() {\n\t\t\tboost::asio::async_read_until( // инициализация асинхронного чтения данных из сокета до тех пор, пока не встретится символ новой строки\n\t\t\t\tsocket,\n\t\t\t\tstreambuf,\n\t\t\t\t\"\\n\",\n\t\t\t\t[self = shared_from_this()](\n\t\t\t\t\t/*\n\t\t\t\t\t это нужно, чтобы при разрушении обьекта session, который в текущий момент управляется указателем в async_accept,\n\t\t\t\t\t//не было проблем с доступом к данным, так как async_accept может быть вызван снова и\n\t\t\t\t\t// создать новый обьект session, который будет управляться другим указателем\n\t\t\t\t\t*/\n\t\t\t\t\tboost::system::error_code error,\n\t\t\t\t\tstd::size_t bytes_transferred) {\n\t\t\t\t\t\tstd::cout << std::istream(&self->streambuf).rdbuf();\n\t\t\t\t}// выводим данные, полученные от клиента, на стандартный вывод)\n\t\t\t);\n\t\t}\n};\nclass server {\n\tboost::asio::io_context& io_context; // свойство класса сервера\n\tboost::asio::ip::tcp::acceptor acceptor; // acceptor будет слушать входящие TCP соединения на сетевом интерфейсе\n\tstd::optional<boost::asio::ip::tcp::socket> socket; // сокет для обмена данными\n\n\tpublic:\n\t\t// optional позволяет нам отложить создание сокета до момента, когда он действительно понадобится\n\t\tserver(boost::asio::io_context& io_context, std::uint16_t port) :\n\t\t\tio_context(io_context),\n\t\t\tacceptor(io_context, boost::asio::ip::tcp::endpoint(boost::asio::ip::tcp::v4(), port)) {}\n\t\t\n\t\tvoid async_accept() { // метод для асинхронного принятия входящих соединений\n\t\t\tsocket.emplace(io_context); // создаем сокет в момент, когда он действительно понадобится\n\t\t\t\n\t\t\tacceptor.async_accept(*socket, [&](boost::system::error_code error) { // лямбда-функция, которая будет вызвана после завершения операции async_accept\n\t\t\t\t\tstd::make_shared<session>(std::move(*socket))->start(); // в заметке обьяснение  \n\t\t\t\t\tasync_accept(); // перезапускаем асинхронное принятие входящих соединений\n\t\t\t\t});\n\t\t}\n\t\t\n};\nint main()\n{\n\t// кстати это ООП концепт системы \n\tboost::asio::io_context io_context; // создаем абстракцию для ввода-вывода\n\tserver srv(io_context, 15001); // создали обьект класса server\n\tsrv.async_accept(); // запустили асинхронное принятие входящих соединений\n\tio_context.run(); // запускаем цикл обработчиков завершения \n\treturn 0;\n}\n\n```","x":960,"y":400,"width":1285,"height":1520},
		{"id":"9c87d4358f85a412","type":"text","text":"### Простой TCP чат\n```c\n#include <boost/asio.hpp>\n#include <optional>\n#include <queue>\n#include <unordered_set>\n\nnamespace io = boost::asio; // создаем псевдоним для пространства имен boost::asio\nusing tcp = io::ip::tcp;\nusing error_code = boost::system::error_code;\nusing namespace std::placeholders;\nusing message_handler = std::function<void(std::string)>; // затычки, чтобы здесь можно было обьявить\nusing error_handler = std::function<void()>;\n\n\nclass session : public std::enable_shared_from_this<session> {\npublic:\n\tsession(tcp::socket&& socket) : socket(std::move(socket)) {}\n\n\tvoid start(message_handler&& on_message, error_handler && on_error) {\n\t\tthis->on_message = std::move(on_message); \n\t\tthis->on_error = std::move(on_error);\n\t\tasync_read();\n\t}\n\t\n\tvoid post(const std::string& message) {\n\t\tbool idle = outgoing.empty();\n\t\toutgoing.push(message);\n\n\t\tif (idle) {\n\t\t\tasync_write();\n\t\t}\n\t}\nprivate:\n\n\tvoid async_read() {\n\t\tio::async_read_until(\n\t\t\tsocket,\n\t\t\tstreambuf,\n\t\t\t\"\\n\",\n\t\t\tstd::bind(&session::on_read, shared_from_this(), _1, _2)\n\t\t);\n\t}\n\n\tvoid on_read(error_code error, std::size_t bytes_transferred) { // вызовется после окончания чтения\n\t\tif (!error) {\n\t\t\tstd::stringstream message;\n\t\t\tmessage << socket.remote_endpoint(error) << \": \"\n\t\t\t\t<< std::istream(&streambuf).rdbuf();\n\t\t\tstreambuf.consume(bytes_transferred);\n\t\t\ton_message(message.str());\n\t\t\tasync_read();\n\t\t}\n\t\telse {\n\t\t\tsocket.close(error);\n\t\t\ton_error();\n\t\t}\n\t}\n\n\tvoid async_write() {\n\t\tio::async_write(\n\t\t\tsocket,\n\t\t\tio::buffer(outgoing.front()),\n\t\t\tstd::bind(&session::on_write, shared_from_this(), _1, _2));\n\t}\n\t\n\tvoid on_write(error_code error, std::size_t bytes_transferred) {\n\t\tif (!error) {\n\t\t\toutgoing.pop();\n\n\t\t\tif (!outgoing.empty()) {\n\t\t\t\tasync_write();\n\t\t\t}\n\t\t}\n\t\telse {\n\t\t\tsocket.close(error);\n\t\t\ton_error();\n\t\t}\n\t}\n\n\ttcp::socket socket;\n\tio::streambuf streambuf;\n\tmessage_handler on_message;\n\terror_handler on_error;\n\tstd::queue<std::string> outgoing;\n\n};\n\nclass server {\n\ttcp::acceptor acceptor; // для прослушивания входящих соединений\n\tstd::optional<tcp::socket> socket; // optional для emplace \n\tstd::unordered_set<std::shared_ptr<session>> clients; // список клиентов\n\tio::io_context& io_context;\n\t\n\npublic:\n\tserver(io::io_context &io_context, std::uint16_t port) :\n\t\tio_context(io_context),\n\t\tacceptor(io_context, tcp::endpoint(tcp::v4(), port)) {}\n\n\tvoid async_accept() {\n\t\t// асинхронно принимаем соединение\n\t\tsocket.emplace(io_context); // привязали сокет к io_context\n\n\t\tacceptor.async_accept(*socket, [&](error_code error) {\n\t\t\tauto client = std::make_shared<session>(std::move(*socket));\n\t\t\tclient->post(\"Welcome to the MITM Proxy Server!\");\n\t\t\tpost(\"New client connected \\n\");\n\n\t\t\tclients.insert(client);\n\n\t\t\tclient->start(\n\t\t\t\tstd::bind(&server::post, this, _1), // вызовется post обьекта сервера при подключении клиента\n\t\t\t\t[&, weak = std::weak_ptr(client)] { // обработчик ошибок(отключения клиента)\n\t\t\t\t\tif (auto shared = weak.lock(); // weak указатели нельзя использовать напрямую, нужно сначала проверить жив ли объект\n\t\t\t\t\t\tshared && clients.erase(shared)) {\n\t\t\t\t\t\tpost(\"We are one less \\n\");\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t);\n\t\t\tasync_accept(); // повторно вызываем async_accept для следующего клиента\n\t\t\t}\n\t\t);\n\t}\n\n\tvoid post(const std::string& message) {\n\t\tfor (auto& client : clients) {\n\t\t\tclient->post(message);\n\t\t}\n\t}\n};\n\nint main() {\n\tio::io_context io_context;\n\tserver srv(io_context, 15001);\n\tsrv.async_accept();\n\tio_context.run();\n\treturn 0;\n}\n","x":-60,"y":420,"width":880,"height":3480}
	],
